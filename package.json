{
  "name": "infinity-fetch",
  "version": "1.5.0",
  "description": "Configurable recursive/infinite fetch utility for paginated APIs: offset, page-number, cursor and Link-header pagination, buffered or streamed. Works in Node.js and browsers.",
  "keywords": [
    "infinity",
    "fetch",
    "pagination",
    "paginate",
    "recursive",
    "cursor",
    "stream",
    "async-iterator",
    "link-header",
    "retry",
    "backoff"
  ],
  "homepage": "https://github.com/ElJijuna/infinity-fetch#readme",
  "bugs": {
    "url": "https://github.com/ElJijuna/infinity-fetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/infinity-fetch.git"
  },
  "license": "MIT",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "npm run lint && npm run format:check && npm run build && npm run test:coverage",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "super-configs": "~1.17.0",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
