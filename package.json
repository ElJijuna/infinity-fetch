{
  "name": "infinity-fetch",
  "version": "1.3.1",
  "description": "Configurable recursive/infinite fetch utility for paginated APIs. Works in Node.js and browsers.",
  "keywords": [
    "infinity",
    "fetch",
    "pagination",
    "recursive"
  ],
  "homepage": "https://github.com/ElJijuna/infinity-fetch#readme",
  "bugs": {
    "url": "https://github.com/ElJijuna/infinity-fetch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/infinity-fetch.git"
  },
  "license": "MIT",
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "npm run lint && npm run format:check && npm run build && npm test",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "super-configs": "^1.15.0",
    "ts-jest": "^29.1.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.5"
  }
}
